PAPERLENS_DOMAIN=paperlens.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-token-from-cloudflare-zero-trust

N8N_PORT=5679
PAPERLENS_TEST_MODE=false
RENDERER_PORT=3001
ASSETS_PORT=8088
WEBSITE_PORT=8080

N8N_HOST=n8n
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-different-long-random-value

GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

MYSQL_DATABASE=heritage_platform
MYSQL_USER=heritage_app
MYSQL_PASSWORD=replace-with-a-long-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-value
AI_KEY_ENCRYPTION_SECRET=replace-with-a-32-byte-random-value
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
APP_ADMIN_NICKNAME=Platform administrator

ASSETS_PUBLIC_URL=https://paperlens.example.com/assets
RENDERER_INTERNAL_URL=http://renderer-api:3000
IMAGE_PROVIDER=qwen-image
QWEN_IMAGE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
GENERATION_VERSION=v4-final-evidence-r2
OCR_ENABLED=true
LOCAL_VISION_ENABLED=true
VISION_MODEL=Xenova/clip-vit-base-patch32

DEEPSEEK_MODEL=deepseek-v4-flash

# Test mode: when enabled, all signed-in users use these platform keys.
# Keep real values only in local .env; never commit them.
PLATFORM_AI_ENABLED=false
PLATFORM_TEXT_PROVIDER=deepseek
PLATFORM_TEXT_API_KEY=
PLATFORM_TEXT_MODEL=deepseek-v4-flash
PLATFORM_IMAGE_PROVIDER=qwen
PLATFORM_IMAGE_API_KEY=
PLATFORM_IMAGE_MODEL=qwen-image-2.0-pro
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_CHECKPOINT=RealVisXL_V5.0_fp16.safetensors
COMFYUI_TIMEOUT_MS=600000
IPADAPTER_ENABLED=true
IPADAPTER_PRESET=STANDARD (medium strength)
IPADAPTER_STRENGTH=0.6
